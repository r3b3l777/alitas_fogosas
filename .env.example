# Copia este archivo como `.env.local` y rellena los valores.
# En Vercel van en Settings → Environment Variables (mismos nombres).
#
# Sólo se usan para el modo "mucha demanda" por sucursal y el login del
# personal. Si los dejas vacíos el sitio funciona igual: el menú, el carrito y
# el pedido por WhatsApp no dependen de Supabase.
#
# Los encuentras en Supabase → Project Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
